<addons>
<addon id="skin.arctic.fuse.3" name="Arctic Fuse 3" provider-name="jurialmunkey" version="3.2.19+ntzb5">
    <requires>
        <import addon="xbmc.gui" version="5.17.0" />
        <import addon="script.skinvariables" version="2.2.2" />
        <import addon="script.texturemaker" version="0.2.9" />
        <import addon="plugin.video.themoviedb.helper" version="6.14.3" />
        <import addon="resource.images.weathericons.white" version="0.0.1" />
        <import addon="resource.images.studios.coloured" version="0.0.1" />
        <import addon="resource.font.robotocjksc" version="0.0.3" />
        <import addon="resource.font.af3hebrew" version="1.1.0" />
    </requires>
    <extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
        <res aspect="16:9" default="true" folder="1080i" width="1920" height="1080" />
        <res aspect="3:2" default="false" folder="1080i" width="1620" height="1080" />
        <res aspect="4:3" default="false" folder="1080i" width="1440" height="1080" />
        <res aspect="16:10" default="false" folder="1080i" width="1728" height="1080" />
        <res aspect="17:9" default="false" folder="1080i" width="2040" height="1080" />
        <res aspect="21:9" default="false" folder="1080i" width="2520" height="1080" />
        <res aspect="19.5:9" default="false" folder="1080i" width="2340" height="1080" />
        <res aspect="18:9" default="false" folder="1080i" width="2160" height="1080" />
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">A minimal row based skin</summary>
        <summary lang="es">Una skin minimalista de diseño horizontal</summary>
        <summary lang="de">Ein minimalistisches, zeilenbasiertes Skin</summary>
        <summary lang="zh">简约行式布局皮肤</summary>
        <summary lang="ar">سكن مخفف بقوائم افقية</summary>
        <description lang="en">Arctic Fuse 3 is a minimal row based skin with customisable widgets</description>
        <description lang="es">Arctic Fuse 3 es una skin minimalista de diseño horizontal con widgets personalizables</description>
        <description lang="de">Arctic Fuse 3 ist ein minimalistisches, zeilenbasiertes Skin mit anpassbaren Widgets</description>
        <description lang="zh">Arctic Fuse 3 是一款采用简约行式布局的 Kodi 皮肤，支持小组件自定义功能</description>
        <description lang="ar">Arctic Fuse 3 سكن مخفف بقوائم افقية وبامكانية تخصيص الاختصارات</description>
        <platform>all</platform>
        <license>Creative Commons Attribution Non-Commercial Share-Alike 4.0</license>
        <forum />
        <source />
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="resource.font.af3hebrew" name="AF3 Hebrew Fonts" version="1.1.0" provider-name="ntzb">
    <requires>
        <import addon="kodi.resource" version="1.0.0"/>
    </requires>
    <extension point="kodi.resource.font" compile="false" />
    <extension point="xbmc.addon.metadata">
        <summary>Inter Unicode with the missing Hebrew final forms restored</summary>
        <description>Hebrew scaled to 0.84 of Latin cap height. Inter-Unicode Regular and Bold with U+05DA, U+05DD, U+05E5, U+FB47, U+200D and U+25CE restored from DejaVu Sans 2.30, the font they were originally merged from. Upstream lost them to a glyph-name collision with Inter.</description>
        <platform>all</platform>
        <license>SIL Open Font License 1.1 / Bitstream Vera</license>
        <assets><icon>icon.png</icon></assets>
    </extension>
</addon>
<addon id="repository.ntzb" name="ntzb Repository" version="1.0.0" provider-name="ntzb">
    <extension point="xbmc.addon.repository" name="ntzb Repository">
        <dir minversion="20.9.1" maxversion="21.9.0">
            <info compressed="false">https://raw.githubusercontent.com/ntzb/repository.ntzb/zips/addons.xml</info>
            <checksum verify="sha256">https://raw.githubusercontent.com/ntzb/repository.ntzb/zips/addons.xml.sha256</checksum>
            <datadir zip="true">https://github.com/ntzb/repository.ntzb/releases/download/</datadir>
        </dir>
        <dir minversion="21.9.1">
            <info compressed="false">https://raw.githubusercontent.com/ntzb/repository.ntzb/zips22/addons.xml</info>
            <checksum verify="sha256">https://raw.githubusercontent.com/ntzb/repository.ntzb/zips22/addons.xml.sha256</checksum>
            <datadir zip="true">https://github.com/ntzb/repository.ntzb/releases/download/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Personal Kodi repository</summary>
        <description>Patched builds of Arctic Fuse 3, rebuilt automatically from each upstream release.</description>
        <platform>all</platform>
        <assets><icon>icon.png</icon></assets>
    </extension>
</addon>
</addons>
