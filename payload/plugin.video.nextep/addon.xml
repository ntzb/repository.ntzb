<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.nextep" version="1.0.0" name="Next Episodes" provider-name="ntzb">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="main.py">
		<provides>video</provides>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Next unwatched episode, one per show</summary>
		<description lang="en_GB">A widget listing the episode to play next for every show you have started, newest first. Built from a single library query with no background service and no cache.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
		<news>First release</news>
	</extension>
</addon>
